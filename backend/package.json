{
  "name": "backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "prettier": "^3.10.1",
    "ts-node": "^10.9.2"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "scripts": {
    "dev": "bun --watch index.ts",
    "start": "bun index.ts",
    "build": "bun build index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "auto-bind": "^5.0.1",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.4.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jalali-moment": "^3.3.11",
    "mongoose": "^9.12.1",
    "zod": "^4.6.7"
  }
}
